{
  "views": [
    {
      "id": "activityInsights.thisMonth.preparation",
      "name": "This Month - Preparation Hours",
      "description": "Current month demo preparation hours (Prep + Prep Activities)",
      "source": "activity-insights",
      "type": "aggregation",
      "query": {
        "filter": "current_month",
        "operation": "sum",
        "field": "hours",
        "categories": ["Demo / Presentation Preparation", "Demo Preparation Activities"]
      }
