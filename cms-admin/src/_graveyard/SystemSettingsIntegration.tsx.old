// ============================================================
// ALTERNATIVE: Minimal Integration Example
// ============================================================

export const MinimalSystemSettings = () => {
  const [showChangeManagement, setShowChangeManagement] = useState(false);

  return (
    <div className="p-8">
      <h1 className="text-3xl font-roobert-heavy mb-6">System Settings</h1>
      
      {/* Simple button to open Change Management */}
      <button
        onClick={() => setShowChangeManagement(true)}
        className="px-6 py-3 bg-fis-eggplant text-white rounded-lg hover:bg-fis-eggplant/90 transition-colors flex items-center gap-2"
      >
        <FileText className="w-5 h-5" />
        View Change Management
      </button>

      {/* Modal */}
      {showChangeManagement && (
        <ChangeManagementModal onClose={() => setShowChangeManagement(false)} />
      )}
    </div>
  );
};

// ============================================================
// USAGE NOTES:
// ============================================================
/**
 * 1. Import the ChangeManagementModal component
 * 2. Add state for modal open/close: useState(false)
 * 3. Add button/link to trigger setShowChangeManagement(true)
 * 4. Render modal conditionally when state is true
 * 5. Pass onClose handler to reset state to false
 * 
 * The modal handles:
 * - Tab switching (Release Notes, Changelog, Dev Tasks)
 * - Section navigation with fixed menu
 * - Markdown rendering with custom styles
 * - Dark mode support
 * - Framer Motion animations
 * - Keyboard navigation (ESC to close)
 */
