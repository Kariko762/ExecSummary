import { useState, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { X, Eye, Code, CheckCircle, AlertTriangle } from 'lucide-react';
import { SummaryDetail } from '../../../src/components/SummaryDetail';
import { OrganizationModal } from '../../../src/components/OrganizationModal';
import { ThemeProvider } from '../../../src/contexts/ThemeContext';
import { PresentationProvider } from '../../../src/contexts/PresentationContext';

interface PreviewModalProps {
  isOpen: boolean;
  onClose: () => void;
  data: any;
  dataType: 'summaries' | 'executive-iq' | 'organizations' | 'performance';
}

type TabType = 'visual' | 'json' | 'validation';

export default function PreviewModal({ isOpen, onClose, data, dataType }: PreviewModalProps) {
  const [activeTab, setActiveTab] = useState<TabType>('visual');
  const previewRef = useRef<HTMLDivElement>(null);

  // Function to capture and download preview as image
  const handleDownloadImage = async () => {
    // Use print to PDF instead of html2canvas to avoid oklch color issues
    window.print();
  };

  // Validation checks
  const validateData = () => {
    const errors: string[] = [];
    const warnings: string[] = [];
    const passed: string[] = [];

    // Check if data exists
    if (!data) {
      errors.push('No data provided');
      return { errors, warnings, passed };
    }

    // Common validation for all types
    if (!data.id) errors.push('Missing required field: id');
    else passed.push('✓ Has unique ID');

    // Type-specific validation
    if (dataType === 'summaries') {
      // Required fields for summaries
      if (!data.quarter) errors.push('Missing required field: quarter');
      else passed.push('✓ Has quarter');

      if (!data.year) errors.push('Missing required field: year');
      else passed.push('✓ Has year');

      if (!data.date) warnings.push('Missing recommended field: date');
      else passed.push('✓ Has date');

      if (!data.title) warnings.push('Missing recommended field: title');
      else passed.push('✓ Has title');

      // Check for common sections
      const sections = ['highlights', 'weeklyFocus', 'keyMetrics', 'outlook'];
      sections.forEach(section => {
        if (data[section]) {
          passed.push(`✓ Has ${section} section`);
        } else {
          warnings.push(`Missing optional section: ${section}`);
        }
      });

      // Check if at least one section is enabled
      const enabledSections = Object.keys(data).filter(key => 
        !key.startsWith('_') && 
        key !== 'id' && 
        key !== 'status' && 
        data[`_enabled_${key}`] !== false
      );
      if (enabledSections.length === 0) {
        warnings.push('No sections are enabled');
      } else {
        passed.push(`✓ ${enabledSections.length} sections enabled`);
      }
    } else if (dataType === 'executive-iq') {
      if (!data.title) errors.push('Missing required field: title');
      else passed.push('✓ Has title');

      if (!data.category) warnings.push('Missing recommended field: category');
      else passed.push('✓ Has category');

      if (!data.content) errors.push('Missing required field: content');
      else passed.push('✓ Has content');
    } else if (dataType === 'organizations') {
      if (!data.name && !data.displayName) errors.push('Missing required field: name or displayName');
      else passed.push('✓ Has organization name');

      if (data.demoStudio) {
        passed.push('✓ Has Demo Studio data');
      }
    } else if (dataType === 'performance') {
      if (!data.name) errors.push('Missing required field: name');
      else passed.push('✓ Has name');
    }

    // Check for valid JSON structure
    try {
      JSON.stringify(data);
      passed.push('✓ Valid JSON structure');
    } catch (e) {
      errors.push('Invalid JSON structure: ' + (e as Error).message);
    }

    return { errors, warnings, passed };
  };

  const validation = validateData();

  if (!isOpen) return null;

  return (
    <AnimatePresence>
      <div className="fixed inset-0 z-[80] flex items-center justify-center p-4 bg-black/60 backdrop-blur-md">
        <motion.div
          initial={{ opacity: 0, scale: 0.95 }}
          animate={{ opacity: 1, scale: 1 }}
          exit={{ opacity: 0, scale: 0.95 }}
          transition={{ duration: 0.2 }}
          className="w-full max-w-7xl h-[95vh] bg-white dark:bg-gray-900 rounded-2xl shadow-2xl flex flex-col overflow-hidden border-2 border-fis-eggplant/20"
        >
          {/* Header */}
          <div className="no-print flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800 bg-gradient-to-r from-fis-eggplant to-fis-raspberry">
            <div>
              <h2 className="text-xl font-roobert-heavy text-white">
                Preview
              </h2>
              <p className="text-xs text-white/80 mt-0.5">
                {data?.title || data?.displayName || data?.name || 'Content Preview'}
              </p>
            </div>
            
            {/* Action Buttons */}
            <div className="flex items-center gap-2">
              {activeTab === 'visual' && (
                <>
                  <button
                    onClick={handleDownloadImage}
                    className="flex items-center gap-2 px-3 py-2 rounded-lg bg-white/20 hover:bg-white/30 text-white text-sm font-roobert-medium transition-all"
                    title="Save as PDF"
                  >
                    <Download className="w-4 h-4" />
                    <span className="hidden sm:inline">Save PDF</span>
                  </button>
                </>
              )}
              <button
                onClick={onClose}
                className="p-2 rounded-lg hover:bg-white/20 transition-colors"
              >
                <X className="w-6 h-6 text-white" />
              </button>
            </div>
          </div>

          {/* Tabs */}
          <div className="no-print flex items-center gap-1 p-2 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
            <button
              onClick={() => setActiveTab('visual')}
              className={`flex items-center gap-2 px-4 py-2 rounded-lg font-roobert-medium text-sm transition-all ${
                activeTab === 'visual'
                  ? 'bg-fis-eggplant text-white shadow-lg'
                  : 'text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700'
              }`}
            >
              <Eye className="w-4 h-4" />
              Visual Preview
            </button>
            <button
              onClick={() => setActiveTab('json')}
              className={`flex items-center gap-2 px-4 py-2 rounded-lg font-roobert-medium text-sm transition-all ${
                activeTab === 'json'
                  ? 'bg-fis-eggplant text-white shadow-lg'
                  : 'text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700'
              }`}
            >
              <Code className="w-4 h-4" />
              JSON Data
            </button>
            <button
              onClick={() => setActiveTab('validation')}
              className={`flex items-center gap-2 px-4 py-2 rounded-lg font-roobert-medium text-sm transition-all ${
                activeTab === 'validation'
                  ? 'bg-fis-eggplant text-white shadow-lg'
                  : 'text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700'
              }`}
            >
              <CheckCircle className="w-4 h-4" />
              Validation
              {validation.errors.length > 0 && (
                <span className="px-2 py-0.5 rounded-full bg-red-500 text-white text-xs font-bold">
                  {validation.errors.length}
                </span>
              )}
              {validation.errors.length === 0 && validation.warnings.length > 0 && (
                <span className="px-2 py-0.5 rounded-full bg-yellow-500 text-white text-xs font-bold">
                  {validation.warnings.length}
                </span>
              )}
            </button>
          </div>

          {/* Tab Content */}
          <div className="flex-1 overflow-hidden">
            {activeTab === 'visual' && (
              <div ref={previewRef} className="h-full overflow-y-auto">
                {dataType === 'summaries' && (
                  <ThemeProvider>
                    <PresentationProvider>
                      <SummaryDetail summary={data} onClose={() => {}} />
                    </PresentationProvider>
                  </ThemeProvider>
                )}

                {dataType === 'organizations' && (
                  <ThemeProvider>
                    <PresentationProvider>
                      <OrganizationModal organization={data} onClose={() => {}} />
                    </PresentationProvider>
                  </ThemeProvider>
                )}

                {dataType === 'executive-iq' && (
                  <div className="h-full p-6 bg-white dark:bg-gray-900">
                    <div className="max-w-4xl mx-auto">
                      <div className="bg-blue-100 dark:bg-blue-900/30 border-2 border-blue-400 dark:border-blue-600 rounded-xl p-4 mb-6">
                        <p className="text-sm text-blue-700 dark:text-blue-400">
                          Executive IQ article preview - Full rendering coming soon
                        </p>
                      </div>
                      <h1 className="text-3xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                        {data?.title || 'Untitled Article'}
                      </h1>
                      {data?.category && (
                        <div className="inline-block px-3 py-1 rounded-full bg-fis-eggplant/10 text-fis-eggplant dark:text-fis-raspberry text-sm font-roobert-medium mb-6">
                          {data.category}
                        </div>
                      )}
                      <div className="prose prose-lg dark:prose-invert max-w-none">
                        <p className="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-wrap">
                          {data?.content || 'No content available'}
                        </p>
                      </div>
                    </div>
                  </div>
                )}

                {dataType === 'performance' && (
                  <div className="h-full p-6 bg-white dark:bg-gray-900">
                    <div className="max-w-4xl mx-auto">
                      <div className="bg-purple-100 dark:bg-purple-900/30 border-2 border-purple-400 dark:border-purple-600 rounded-xl p-4 mb-6">
                        <p className="text-sm text-purple-700 dark:text-purple-400">
                          Performance data preview - Chart rendering coming soon
                        </p>
                      </div>
                      <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                        {data?.name || 'Performance Data'}
                      </h2>
                      <pre className="text-sm bg-gray-900 dark:bg-black text-green-400 p-4 rounded-lg overflow-x-auto">
                        {JSON.stringify(data, null, 2)}
                      </pre>
                    </div>
                  </div>
                )}
              </div>
            )}
                      {/* Summary Header */}
                      <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                        <div className="flex items-center justify-between mb-4">
                          <div>
                            <h1 className="text-3xl font-roobert-heavy text-gray-900 dark:text-white mb-2">
                              {data?.title || 'Executive Summary'}
                            </h1>
                            <div className="flex items-center gap-3 text-sm">
                              <span className="px-3 py-1 rounded-full bg-fis-eggplant/10 text-fis-eggplant dark:text-fis-raspberry font-roobert-medium">
                                {data?.quarter} {data?.year}
                              </span>
                              <span className="text-gray-600 dark:text-gray-400 font-roobert-regular">
                                {data?.date}
                              </span>
                            </div>
                          </div>
                          <div className={`px-4 py-2 rounded-full font-roobert-bold text-sm ${
                            data?.status === 'published' 
                              ? 'bg-green-500 text-white' 
                              : 'bg-yellow-500 text-gray-900'
                          }`}>
                            {data?.status === 'published' ? '● LIVE' : '● DRAFT'}
                          </div>
                        </div>
                      </div>

                      {/* Highlights */}
                      {data?.highlights && Array.isArray(data.highlights) && data.highlights.length > 0 && (
                        <div>
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                            Key Highlights
                          </h2>
                          <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-6 space-y-3">
                            {data.highlights.map((highlight: string, idx: number) => (
                              <div key={idx} className="flex items-start space-x-3">
                                <div className="w-6 h-6 rounded-full bg-fis-raspberry flex items-center justify-center flex-shrink-0 mt-0.5">
                                  <span className="text-white text-xs font-roobert-bold">
                                    {idx + 1}
                                  </span>
                                </div>
                                <div 
                                  className="text-base font-roobert-regular text-gray-700 dark:text-gray-300 flex-1"
                                  dangerouslySetInnerHTML={{ __html: parseExpressions(highlight) }}
                                />
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Weekly Focus */}
                      {data?.weeklyFocus && Array.isArray(data.weeklyFocus) && data.weeklyFocus.length > 0 && (
                        <div>
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                            This Week's Focus
                          </h2>
                          <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-6 space-y-3">
                            {data.weeklyFocus.map((focus: string, idx: number) => (
                              <div key={idx} className="flex items-start space-x-3">
                                <div className="w-6 h-6 rounded-full bg-fis-raspberry flex items-center justify-center flex-shrink-0 mt-0.5">
                                  <span className="text-white text-xs font-roobert-bold">
                                    {idx + 1}
                                  </span>
                                </div>
                                <div 
                                  className="text-base font-roobert-regular text-gray-700 dark:text-gray-300 flex-1"
                                  dangerouslySetInnerHTML={{ __html: parseExpressions(focus) }}
                                />
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Departments & Initiatives Grid */}
                      {((data?.departments && data.departments.length > 0) || (data?.initiatives && data.initiatives.length > 0)) && (
                        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                          {/* Department Performance */}
                          {data?.departments && data.departments.length > 0 && (
                            <div>
                              <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                                Department Performance
                              </h2>
                              <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-6">
                                <div className="space-y-3">
                                  {data.departments.map((dept: any, idx: number) => (
                                    <div key={idx} className="flex items-center justify-between">
                                      <div className="flex items-center space-x-3">
                                        <div
                                          className="w-3 h-3 rounded-full"
                                          style={{
                                            backgroundColor:
                                              dept.performance >= 90
                                                ? '#10B981'
                                                : dept.performance >= 80
                                                ? '#3B82F6'
                                                : '#F59E0B',
                                          }}
                                        />
                                        <span className="text-sm font-roobert-medium text-gray-700 dark:text-gray-300">
                                          {dept.name}
                                        </span>
                                      </div>
                                      <span className="text-sm font-roobert-bold text-gray-900 dark:text-white">
                                        {dept.performance}%
                                      </span>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            </div>
                          )}

                          {/* Strategic Initiatives */}
                          {data?.initiatives && data.initiatives.length > 0 && (
                            <div>
                              <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                                Strategic Initiatives
                              </h2>
                              <div className="space-y-3">
                                {data.initiatives.map((initiative: any, idx: number) => {
                                  const getProgressBarColor = (status: string) => {
                                    switch (status) {
                                      case 'on-track':
                                        return 'bg-fis-green';
                                      case 'at-risk':
                                        return 'bg-fis-raspberry';
                                      case 'delayed':
                                        return 'bg-fis-eggplant';
                                      default:
                                        return 'bg-gray-500';
                                    }
                                  };

                                  const getStatusBadge = (status: string) => {
                                    switch (status) {
                                      case 'on-track':
                                        return 'bg-fis-green/20 text-fis-green';
                                      case 'at-risk':
                                        return 'bg-fis-raspberry/20 text-fis-raspberry';
                                      case 'delayed':
                                        return 'bg-fis-eggplant/20 text-fis-eggplant';
                                      default:
                                        return 'bg-gray-500/20 text-gray-700 dark:text-gray-300';
                                    }
                                  };

                                  return (
                                    <div key={idx} className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-4">
                                      <div className="flex items-start justify-between mb-3">
                                        <div className="flex-1">
                                          <h4 className="text-base font-roobert-medium text-gray-900 dark:text-white mb-1">
                                            {initiative.name}
                                          </h4>
                                          <p className="text-xs font-roobert-regular text-gray-500 dark:text-gray-400">
                                            {initiative.owner}
                                          </p>
                                        </div>
                                        <div className={`px-2 py-1 rounded-full text-xs font-roobert-medium capitalize ${getStatusBadge(initiative.status)}`}>
                                          {initiative.status.replace('-', ' ')}
                                        </div>
                                      </div>
                                      <div className="relative w-full h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                        <div
                                          className={`absolute top-0 left-0 h-full rounded-full ${getProgressBarColor(initiative.status)}`}
                                          style={{ width: `${initiative.progress}%` }}
                                        />
                                      </div>
                                      <p className="text-xs font-roobert-medium text-gray-500 dark:text-gray-400 mt-2">
                                        {initiative.progress}% complete
                                      </p>
                                    </div>
                                  );
                                })}
                              </div>
                            </div>
                          )}
                        </div>
                      )}

                      {/* Key Metrics */}
                      {data?.keyMetrics && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                            Key Metrics
                          </h2>
                          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            {/* Handle both array and object formats */}
                            {Array.isArray(data.keyMetrics) ? (
                              // Array format from JSON
                              data.keyMetrics.map((metric: any, idx: number) => {
                                const getIcon = (label: string) => {
                                  const lowerLabel = label.toLowerCase();
                                  if (lowerLabel.includes('revenue') || lowerLabel.includes('dollar')) return '💵';
                                  if (lowerLabel.includes('customer') || lowerLabel.includes('user')) return '👥';
                                  if (lowerLabel.includes('growth') || lowerLabel.includes('increase')) return '📈';
                                  if (lowerLabel.includes('satisfaction') || lowerLabel.includes('nps') || lowerLabel.includes('score')) return '👍';
                                  return '📊';
                                };
                                
                                const formatValue = (value: string, unit: string) => {
                                  const numValue = parseFloat(value);
                                  if (isNaN(numValue)) return value;
                                  
                                  if (unit === '$') {
                                    return new Intl.NumberFormat('en-US', {
                                      style: 'currency',
                                      currency: 'USD',
                                      minimumFractionDigits: 0,
                                      maximumFractionDigits: 0,
                                    }).format(numValue);
                                  } else if (unit === '%') {
                                    return `+${numValue}%`;
                                  } else {
                                    return new Intl.NumberFormat('en-US').format(numValue);
                                  }
                                };
                                
                                return (
                                  <div key={idx} className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-5">
                                    <div className="flex items-center space-x-2 mb-3">
                                      <div className="w-10 h-10 rounded-lg bg-fis-eggplant/20 flex items-center justify-center text-xl">
                                        {getIcon(metric.label)}
                                      </div>
                                    </div>
                                    <p className="text-sm font-roobert-regular text-gray-500 dark:text-gray-400 mb-1">
                                      {metric.label}
                                    </p>
                                    <p className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                      {formatValue(metric.value, metric.unit)}
                                    </p>
                                  </div>
                                );
                              })
                            ) : (
                              // Object format (TypeScript interface)
                              <>
                                <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-5">
                                  <div className="flex items-center space-x-2 mb-3">
                                    <div className="w-10 h-10 rounded-lg bg-fis-eggplant/20 flex items-center justify-center text-xl">
                                      💵
                                    </div>
                                  </div>
                                  <p className="text-sm font-roobert-regular text-gray-500 dark:text-gray-400 mb-1">
                                    Revenue
                                  </p>
                                  <p className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                    {new Intl.NumberFormat('en-US', {
                                      style: 'currency',
                                      currency: 'USD',
                                      minimumFractionDigits: 0,
                                    }).format(data.keyMetrics.revenue || 0)}
                                  </p>
                                </div>
                                <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-5">
                                  <div className="flex items-center space-x-2 mb-3">
                                    <div className="w-10 h-10 rounded-lg bg-fis-navy/20 flex items-center justify-center text-xl">
                                      👥
                                    </div>
                                  </div>
                                  <p className="text-sm font-roobert-regular text-gray-500 dark:text-gray-400 mb-1">
                                    Customers
                                  </p>
                                  <p className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                    {new Intl.NumberFormat('en-US').format(data.keyMetrics.customers || 0)}
                                  </p>
                                </div>
                                <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-5">
                                  <div className="flex items-center space-x-2 mb-3">
                                    <div className="w-10 h-10 rounded-lg bg-fis-green/20 flex items-center justify-center text-xl">
                                      📈
                                    </div>
                                  </div>
                                  <p className="text-sm font-roobert-regular text-gray-500 dark:text-gray-400 mb-1">
                                    Growth
                                  </p>
                                  <p className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                    +{data.keyMetrics.growth || 0}%
                                  </p>
                                </div>
                                <div className="bg-white dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 shadow-md rounded-xl p-5">
                                  <div className="flex items-center space-x-2 mb-3">
                                    <div className="w-10 h-10 rounded-lg bg-fis-eggplant/20 flex items-center justify-center text-xl">
                                      👍
                                    </div>
                                  </div>
                                  <p className="text-sm font-roobert-regular text-gray-500 dark:text-gray-400 mb-1">
                                    NPS Score
                                  </p>
                                  <p className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                    {data.keyMetrics.satisfaction || 0}
                                  </p>
                                </div>
                              </>
                            )}
                          </div>
                        </div>
                      )}

                      {/* Issues & Blockers */}
                      {data?.issuesAndBlockers && Array.isArray(data.issuesAndBlockers) && data.issuesAndBlockers.length > 0 && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                            <AlertTriangle className="w-6 h-6 text-red-500" />
                            Issues & Blockers
                          </h2>
                          <div className="space-y-4">
                            {data.issuesAndBlockers.map((issue: any, idx: number) => (
                              <div key={idx} className="bg-red-50 dark:bg-red-900/20 rounded-xl p-4 border-l-4 border-red-500">
                                <h3 className="text-lg font-roobert-semibold text-gray-900 dark:text-white mb-2">
                                  {issue.title}
                                </h3>
                                {issue.description && (
                                  <div 
                                    className="text-sm text-gray-700 dark:text-gray-300 mb-3"
                                    dangerouslySetInnerHTML={{ __html: parseExpressions(issue.description) }}
                                  />
                                )}
                                <div className="flex items-center gap-4 text-xs">
                                  {issue.impact && (
                                    <span className={`px-2 py-1 rounded-full font-roobert-medium ${
                                      issue.impact === 'critical' ? 'bg-red-600 text-white' :
                                      issue.impact === 'high' ? 'bg-orange-500 text-white' :
                                      issue.impact === 'medium' ? 'bg-yellow-500 text-gray-900' :
                                      'bg-blue-500 text-white'
                                    }`}>
                                      {issue.impact.toUpperCase()} IMPACT
                                    </span>
                                  )}
                                  {issue.status && (
                                    <span className="text-gray-600 dark:text-gray-400 font-roobert-medium">
                                      Status: {issue.status}
                                    </span>
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Risks */}
                      {data?.risks && Array.isArray(data.risks) && data.risks.length > 0 && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                            Risks
                          </h2>
                          <div className="space-y-4">
                            {data.risks.map((risk: any, idx: number) => (
                              <div key={idx} className="bg-yellow-50 dark:bg-yellow-900/20 rounded-xl p-4 border-l-4 border-yellow-500">
                                <h3 className="text-lg font-roobert-semibold text-gray-900 dark:text-white mb-2">
                                  {risk.title}
                                </h3>
                                {risk.description && (
                                  <div 
                                    className="text-sm text-gray-700 dark:text-gray-300 mb-3"
                                    dangerouslySetInnerHTML={{ __html: parseExpressions(risk.description) }}
                                  />
                                )}
                                <div className="flex items-center gap-4 text-xs">
                                  {risk.likelihood && (
                                    <span className="text-gray-600 dark:text-gray-400 font-roobert-medium">
                                      Likelihood: {risk.likelihood}
                                    </span>
                                  )}
                                  {risk.impact && (
                                    <span className="text-gray-600 dark:text-gray-400 font-roobert-medium">
                                      Impact: {risk.impact}
                                    </span>
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Outlook */}
                      {data?.outlook && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                            Outlook
                          </h2>
                          <div 
                            className="text-gray-700 dark:text-gray-300 font-roobert-regular leading-relaxed"
                            dangerouslySetInnerHTML={{ __html: parseExpressions(data.outlook) }}
                          />
                        </div>
                      )}
                    </>
                  )}

                  {dataType === 'organizations' && (
                    <>
                      {/* Organization Header */}
                      <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                        <div className="flex items-center gap-4 mb-4">
                          <Building2 className="w-12 h-12 text-fis-raspberry" />
                          <div>
                            <h1 className="text-3xl font-roobert-heavy text-gray-900 dark:text-white">
                              {data?.name || 'Organization'}
                            </h1>
                            <p className="text-gray-600 dark:text-gray-400 font-roobert-regular">
                              {data?.description || 'No description available'}
                            </p>
                          </div>
                        </div>
                        {data?.status && (
                          <div className={`inline-block px-4 py-2 rounded-full font-roobert-bold text-sm ${
                            data.status === 'active' 
                              ? 'bg-green-500 text-white' 
                              : 'bg-gray-500 text-white'
                          }`}>
                            {data.status.toUpperCase()}
                          </div>
                        )}
                      </div>

                      {/* Key Stats */}
                      {data?.stats && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                            <Target className="w-6 h-6 text-fis-raspberry" />
                            Key Statistics
                          </h2>
                          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                            {Object.entries(data.stats).map(([key, value]: [string, any]) => (
                              <div key={key} className="bg-gradient-to-br from-fis-eggplant/10 to-fis-raspberry/10 rounded-xl p-4 border border-fis-eggplant/20">
                                <div className="text-sm font-roobert-medium text-gray-600 dark:text-gray-400 mb-1 capitalize">
                                  {key.replace(/([A-Z])/g, ' $1').trim()}
                                </div>
                                <div className="text-2xl font-roobert-bold text-gray-900 dark:text-white">
                                  {value}
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Team Members */}
                      {data?.team && Array.isArray(data.team) && data.team.length > 0 && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                            <Users className="w-6 h-6 text-fis-raspberry" />
                            Team ({data.team.length})
                          </h2>
                          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {data.team.map((member: any, idx: number) => (
                              <div key={idx} className="bg-white/50 dark:bg-gray-800/50 rounded-xl p-4">
                                <h3 className="font-roobert-semibold text-gray-900 dark:text-white mb-1">
                                  {member.name}
                                </h3>
                                <p className="text-sm text-gray-600 dark:text-gray-400">
                                  {member.role}
                                </p>
                                {member.email && (
                                  <p className="text-xs text-gray-500 dark:text-gray-500 mt-2">
                                    {member.email}
                                  </p>
                                )}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Additional Content */}
                      {data?.content && (
                        <div className="glass-strong rounded-2xl p-6 border-2 border-white/20">
                          <div 
                            className="text-gray-700 dark:text-gray-300 font-roobert-regular leading-relaxed"
                            dangerouslySetInnerHTML={{ __html: parseExpressions(data.content) }}
                          />
                        </div>
                      )}
                    </>
                  )}

                {dataType === 'executive-iq' && (
                  <div className="h-full p-6">
                    <div className="max-w-4xl mx-auto">
                      <div className="bg-blue-100 dark:bg-blue-900/30 border-2 border-blue-400 dark:border-blue-600 rounded-xl p-4 mb-6">
                        <div className="flex items-start gap-3">
                          <Info className="w-6 h-6 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" />
                          <div>
                            <h3 className="font-roobert-bold text-blue-800 dark:text-blue-300 mb-1">
                              Executive IQ Article Preview
                            </h3>
                            <p className="text-sm text-blue-700 dark:text-blue-400">
                              Showing the raw content. Full article rendering coming soon.
                            </p>
                          </div>
                        </div>
                      </div>

                      <div className="glass-strong rounded-xl p-6 border-2 border-white/20">
                        <h1 className="text-3xl font-roobert-heavy text-gray-900 dark:text-white mb-4">
                          {data?.title || 'Untitled Article'}
                        </h1>
                        {data?.category && (
                          <div className="inline-block px-3 py-1 rounded-full bg-fis-eggplant/10 text-fis-eggplant dark:text-fis-raspberry text-sm font-roobert-semibold mb-6">
                            {data.category}
                          </div>
                        )}
                        <div className="prose prose-lg dark:prose-invert max-w-none">
                          <p className="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-wrap">
                            {data?.content || 'No content available'}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {dataType === 'performance' && (
                  <div className="h-full p-6">
                    <div className="max-w-4xl mx-auto">
                      <div className="bg-purple-100 dark:bg-purple-900/30 border-2 border-purple-400 dark:border-purple-600 rounded-xl p-4 mb-6">
                        <div className="flex items-start gap-3">
                          <Info className="w-6 h-6 text-purple-600 dark:text-purple-400 flex-shrink-0 mt-0.5" />
                          <div>
                            <h3 className="font-roobert-bold text-purple-800 dark:text-purple-300 mb-1">
                              Performance Data Preview
                            </h3>
                            <p className="text-sm text-purple-700 dark:text-purple-400">
                              Showing the data structure. Chart rendering coming soon.
                            </p>
                          </div>
                        </div>
                      </div>

                      <div className="glass-strong rounded-xl p-6 border-2 border-white/20">
                        <h2 className="text-2xl font-roobert-bold text-gray-900 dark:text-white mb-4">
                          {data?.name || 'Performance Data'}
                        </h2>
                        <pre className="text-sm bg-gray-900 dark:bg-black text-green-400 p-4 rounded-lg overflow-x-auto">
                          {JSON.stringify(data, null, 2)}
                        </pre>
                      </div>
                    </div>
                  </div>
                )}
                </div>
              </div>
            )}

            {activeTab === 'json' && (
              <div className="h-full overflow-y-auto p-4">
                <div className="glass-strong rounded-xl p-4 border-2 border-white/20">
                  <div className="flex items-center justify-between mb-3">
                    <h3 className="text-sm font-roobert-bold text-gray-900 dark:text-white">
                      JSON Structure
                    </h3>
                    <button
                      onClick={() => {
                        navigator.clipboard.writeText(JSON.stringify(data, null, 2));
                      }}
                      className="px-3 py-1.5 rounded-lg bg-fis-eggplant/10 hover:bg-fis-eggplant/20 text-fis-eggplant dark:text-fis-raspberry text-xs font-roobert-medium transition-all"
                    >
                      Copy JSON
                    </button>
                  </div>
                  <pre className="text-xs font-mono bg-gray-900 dark:bg-black text-green-400 p-4 rounded-lg overflow-x-auto">
                    {JSON.stringify(data, null, 2)}
                  </pre>
                </div>
              </div>
            )}

            {activeTab === 'validation' && (
              <div className="h-full overflow-y-auto p-6">
                <div className="max-w-4xl mx-auto space-y-4">
                  {/* Errors */}
                  {validation.errors.length > 0 && (
                    <div className="bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 rounded-xl p-4">
                      <h3 className="text-lg font-roobert-bold text-red-800 dark:text-red-300 mb-3 flex items-center gap-2">
                        <AlertTriangle className="w-5 h-5" />
                        Errors ({validation.errors.length})
                      </h3>
                      <ul className="space-y-2">
                        {validation.errors.map((error, idx) => (
                          <li key={idx} className="flex items-start gap-2 text-sm text-red-700 dark:text-red-400">
                            <span className="text-red-500 dark:text-red-400 font-bold">✗</span>
                            <span className="font-roobert-medium">{error}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Warnings */}
                  {validation.warnings.length > 0 && (
                    <div className="bg-yellow-50 dark:bg-yellow-900/20 border-2 border-yellow-200 dark:border-yellow-800 rounded-xl p-4">
                      <h3 className="text-lg font-roobert-bold text-yellow-800 dark:text-yellow-300 mb-3 flex items-center gap-2">
                        <AlertTriangle className="w-5 h-5" />
                        Warnings ({validation.warnings.length})
                      </h3>
                      <ul className="space-y-2">
                        {validation.warnings.map((warning, idx) => (
                          <li key={idx} className="flex items-start gap-2 text-sm text-yellow-700 dark:text-yellow-400">
                            <span className="text-yellow-500 dark:text-yellow-400 font-bold">⚠</span>
                            <span className="font-roobert-medium">{warning}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Passed Checks */}
                  {validation.passed.length > 0 && (
                    <div className="bg-green-50 dark:bg-green-900/20 border-2 border-green-200 dark:border-green-800 rounded-xl p-4">
                      <h3 className="text-lg font-roobert-bold text-green-800 dark:text-green-300 mb-3 flex items-center gap-2">
                        <CheckCircle className="w-5 h-5" />
                        Passed ({validation.passed.length})
                      </h3>
                      <ul className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        {validation.passed.map((check, idx) => (
                          <li key={idx} className="flex items-start gap-2 text-sm text-green-700 dark:text-green-400">
                            <span className="text-green-500 dark:text-green-400 font-bold">✓</span>
                            <span className="font-roobert-medium">{check}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* Summary */}
                  <div className="glass-strong rounded-xl p-6 border-2 border-white/20">
                    <h3 className="text-lg font-roobert-bold text-gray-900 dark:text-white mb-4">
                      Validation Summary
                    </h3>
                    <div className="grid grid-cols-3 gap-4">
                      <div className="text-center">
                        <div className={`text-3xl font-roobert-heavy mb-1 ${
                          validation.errors.length === 0 ? 'text-green-600' : 'text-red-600'
                        }`}>
                          {validation.errors.length}
                        </div>
                        <div className="text-xs font-roobert-medium text-gray-600 dark:text-gray-400">
                          Errors
                        </div>
                      </div>
                      <div className="text-center">
                        <div className="text-3xl font-roobert-heavy text-yellow-600 mb-1">
                          {validation.warnings.length}
                        </div>
                        <div className="text-xs font-roobert-medium text-gray-600 dark:text-gray-400">
                          Warnings
                        </div>
                      </div>
                      <div className="text-center">
                        <div className="text-3xl font-roobert-heavy text-green-600 mb-1">
                          {validation.passed.length}
                        </div>
                        <div className="text-xs font-roobert-medium text-gray-600 dark:text-gray-400">
                          Passed
                        </div>
                      </div>
                    </div>

                    {validation.errors.length === 0 && (
                      <div className="mt-6 p-4 bg-green-100 dark:bg-green-900/30 rounded-lg">
                        <p className="text-sm text-green-800 dark:text-green-300 font-roobert-medium text-center">
                          ✅ All validation checks passed! This data is ready to publish.
                        </p>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            )}
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
}
