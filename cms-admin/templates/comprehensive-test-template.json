      "sectionLayoutType": "left-50",
      "fields": [
        {
          "key": "metricCardsLeft",
          "label": "Metric Cards (Left)",
          "renderType": "metricCards",
          "layoutZone": "left-50",
          "rowIndex": 0,
          "schema": {
            "type": "array",
            "renderAs": "metricCards",
            "label": "Metric Cards",
            "itemSchema": {
              "type": "object",
              "renderAs": "objectForm",
              "fields": {
                "label": {
                  "type": "string",
                  "renderAs": "text",
                  "label": "Label"
                },
                "value": {
                  "type": "string",
                  "renderAs": "text",
                  "label": "Value"
                },
                "trend": {
                  "type": "string",
                  "renderAs": "text",
                  "label": "Trend"
                }
              }
            }
          },
          "exampleData": [
            { "label": "Revenue", "value": "$2.4M", "trend": "+12%" },
            { "label": "Customers", "value": "1,234", "trend": "+8%" }
