{
  "templateName": "Comprehensive Test Template",
  "templateDescription": "Complete test template with every asset type and layout pattern",
  "category": "test",
  "version": "1.0.0",
  "createdAt": "2025-11-09",
  "sections": [
    {
      "id": "section-header",
      "name": "Standard Header",
      "fields": [
        {
          "key": "id",
          "label": "ID",
          "renderType": "text",
          "schema": {
            "type": "string",
            "renderAs": "text",
            "label": "ID",
            "placeholder": "Auto-generated"
          }
        },
        {
          "key": "quarter",
          "label": "Quarter",
          "renderType": "text",
          "schema": {
            "type": "string",
            "renderAs": "text",
            "label": "Quarter",
            "placeholder": "e.g., Q1, Month Day"
          }
        },
        {
          "key": "year",
          "label": "Year",
          "renderType": "number",
          "schema": {
            "type": "number",
            "renderAs": "number",
            "label": "Year"
          }
        },
        {
          "key": "date",
          "label": "Date",
          "renderType": "date",
          "schema": {
            "type": "string",
            "renderAs": "date",
            "label": "Date"
          }
        },
        {
          "key": "title",
          "label": "Title",
          "renderType": "text",
          "schema": {
            "type": "string",
            "renderAs": "text",
            "label": "Title",
            "placeholder": "Your Organization Name - Weekly Executive Update"
          }
        }
      ]
    },
    {
      "id": "section-full-width",
      "name": "Full Width Layout Test",
      "sectionLayoutType": "full",
      "fields": [
        {
          "key": "richTextTest",
          "label": "Rich Text Editor",
          "renderType": "richText",
          "layoutZone": "full",
          "rowIndex": 0,
          "schema": {
            "type": "string",
            "renderAs": "richText",
            "label": "Rich Text Editor",
            "placeholder": "Enter formatted text here..."
          }
        },
        {
          "key": "barChartTest",
          "label": "Bar Chart",
          "renderType": "barChart",
          "layoutZone": "full",
          "rowIndex": 1,
          "schema": {
            "type": "array",
            "renderAs": "barChart",
            "label": "Bar Chart",
            "itemSchema": {
              "type": "object",
              "renderAs": "objectForm",
              "fields": {
                "label": {
                  "type": "string",
                  "renderAs": "text",
                  "label": "Label"
                },
                "value": {
                  "type": "number",
                  "renderAs": "number",
                  "label": "Value"
                }
              }
            },
            "chartConfig": {
              "xKey": "label",
              "yKey": "value",
              "color": "#6b46c1"
            }
          },
          "exampleData": [
            { "label": "Jan", "value": 65 },
            { "label": "Feb", "value": 78 },
            { "label": "Mar", "value": 90 }
          ]
        },
        {
          "key": "pieChartTest",
          "label": "Pie Chart",
          "renderType": "pieChart",
          "layoutZone": "full",
          "rowIndex": 2,
          "schema": {
            "type": "array",
            "renderAs": "pieChart",
            "label": "Pie Chart",
            "itemSchema": {
              "type": "object",
              "renderAs": "objectForm",
              "fields": {
                "label": {
                  "type": "string",
                  "renderAs": "text",
                  "label": "Label"
                },
                "value": {
                  "type": "number",
                  "renderAs": "number",
                  "label": "Value"
                }
              }
            },
            "chartConfig": {
              "nameKey": "label",
              "dataKey": "value"
            }
          },
          "exampleData": [
            { "label": "Enterprise", "value": 45 },
            { "label": "Mid-Market", "value": 30 },
            { "label": "SMB", "value": 25 }
          ]
        }
      ]
    },
    {
      "id": "section-50-50",
