      </div>

      <div className="mt-4 pt-3 border-t border-white/10">
        <div className="flex items-start gap-2 text-[9px] text-white/60 font-roobert-light">
          <AlertCircle className="w-3 h-3 mt-0.5 flex-shrink-0" />
          <div>
            <div className="font-roobert-bold text-white/80 mb-1">Upsell opti Advanced:</div>
            <p>Copilot to create ci uses SlightPlan for payee time, Or Forecast pack: trials, drivers, diversity upside carrying 10 times common.</p>
          </div>
        </div>
      </div>
    </div>
  );
}

