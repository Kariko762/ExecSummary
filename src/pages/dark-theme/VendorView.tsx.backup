          <div className="flex items-center justify-between">
            <span className="text-white/70 font-roobert-light">Tickets Submitted</span>
            <span className="text-white font-roobert-medium">{data.ticketsSubmitted}</span>
          </div>
          <div className="flex items-center justify-between">
